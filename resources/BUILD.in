
asset_project(
    name = 'cozmo_resources_assets',
    srcs = subdir_glob([
                ('assets', 'cladToFileMaps/*.json'),
                ('assets', 'RewardedActions/RewardedActions.json'),
                ('assets', 'cubeFirmware/cube.dfu'),
                ('assets', 'LocalizedStrings/**/*.json'),
                ('3rd/snowboy', 'snowboyModels/*.res'),
                ('3rd/snowboy', 'snowboyModels/*.umdl'),
                ('3rd/snowboy', 'snowboyModels/*.pmdl'),
                ('3rd/pryon_lite', 'pryonSpeechRecModels/**/*.bin'),
                ('animation-assets', 'animations/**/*.bin'),
                ('animation-assets', 'animationGroups/**/*.json'),
                ('animation-assets', 'sprites/**/*.png'),
                ('animation-assets', 'faceAnimations/**/*.png'),
                ('animation-assets', 'anim_manifest.json'),
                ('animation-assets', 'compositeImageResources/imageLayouts/**/*.json'),
                ('animation-assets', 'compositeImageResources/imageMaps/**/*.json'),
                ],
                prefix = 'assets'
            ),
)

asset_project(
    name = 'cozmo_resources_sound',
    srcs = glob([
                'sound/**/*'
                ],
           ),
)

asset_project(
    name = 'cozmo_resources_local_sound',
    srcs = [],
    platform_srcs = [
        ('mateos', subdir_glob([
            ('EXTERNALS/local-audio-assets/mate_robot/mate_linux', '**/*')
            ],
            prefix = 'sound')
        ),
        ('mac', subdir_glob([
            ('EXTERNALS/local-audio-assets/mate_robot/dev_mac', '**/*')
            ],
            prefix = 'sound')
        ),
    ]
)

