cxx_project(
    name = 'cubeBleClient',
    srcs = cxx_src_glob(['.'],
                        excludes = ['*_mac.*',
                                    '*_mateos.*',
                                    './bleClient/*',
                                    ]),
    platform_srcs = [
        ('mateos', glob(['**/*_mateos.cpp',
                          '**/bleClient/*'])),
        ('mac', glob(['**/*_mac.cpp']))
    ],
    headers = cxx_header_glob(['.'])
)
