cxx_project(
    name = 'osState',
    srcs = cxx_src_glob(['.'],
                        excludes = ['*_mac.*',
                                    '*_mateos.*']),
    platform_srcs = [
        ('mac', glob(['**/*_mac.cpp'])),
        ('mateos', glob(['**/*_mateos.cpp']))
    ],
    headers = cxx_header_glob(['.'])
)
