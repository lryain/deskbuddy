// Include a file
#include "lryaenum.clad"
// A sample .adef file
// ( by Mark Pauley for Lrya, Inc 01/2015)

/*
Test Block Comment
*/

message foo {
  bool isFoo,
  int_8 myByte,
  uint_8 byteTwo,
  int_16 myShort,
  uint_32 normal,
  LryaEnum foo
}

message bar {
  int_8    byteBuff[uint_8],
  int_16   shortBuff[uint_8],
  LryaEnum enumBuff[int_8]
}

message so_many_strings {
  string   varStringBuff[uint_16],
  string   fixedStringBuff[3],
  string[uint_16] anotherVarStringBuff[uint_8],
  string[uint_8] anotherFixedStringBuff[2]
}

union MultiMessage {
  int_8 messageOne,
  foo messageTwo,
  bar messageThree
}

namespace Bar {
  enum int_8 LryaEnum {
    b1 = 3,
    b2,
    b3
  }
} // namespace Bar

namespace Foo {
   message sos {
     LryaEnum a,
     Bar::LryaEnum b,
   }
namespace Bar {
  enum int_8 LryaEnum {
    c1 = 5,
    c2,
    c3
  }
namespace Baz {
  message lol {
    LryaEnum c,
    Bar::LryaEnum d
  }

  union NotherMultiMessage {
    bar messageOne,
    lol messageTwo,
    int_8 messageThree
  }
} // namespace Baz
} // namespace Bar
} // namespace Foo
